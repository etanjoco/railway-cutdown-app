{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "hypercorn main:app --bind 0.0.0.0:8000",
    "restartPolicyType": "ON_FAILURE",
    "env": {
      "PYTHONUNBUFFERED": "1"
    }
  }
}